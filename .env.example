# Copy to .env and edit. NEVER commit .env.
ENVIRONMENT=development            # production requires SECRET_KEY + ENCRYPTION_KEY below
DRIVER_MODE=cisco                  # cisco = real SSH via Netmiko | mock = in-memory simulator for demos

# Database: SQLite for dev, PostgreSQL for production
DATABASE_URL=sqlite:///./autonetops.db
# DATABASE_URL=postgresql+psycopg://autonetops:CHANGE_ME@postgres:5432/autonetops

# Keys (production). Generate:
#   SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing ENCRYPTION_KEY makes stored credentials and backup files unreadable - back it up separately.
SECRET_KEY=
ENCRYPTION_KEY=

# First admin (created only when no users exist). Min 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Docker Compose only: password for the bundled PostgreSQL
POSTGRES_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# SSH host-key verification. Strict = refuse unknown/changed keys (recommended).
SSH_STRICT_HOST_KEY=true
# File in OpenSSH known_hosts format, e.g.:  ssh-keyscan -p 22 192.0.2.10 >> secrets/known_hosts
SSH_KNOWN_HOSTS_FILE=./secrets/known_hosts

MAX_CONCURRENT_JOBS=5
MAX_RETRIES=2
RESTORE_REQUIRES_APPROVAL=false    # true = second administrator must approve every restore
RESTORE_SAVE_STARTUP=false

# Optional notifications (never contain configs or secrets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=autonetops@localhost
NOTIFY_EMAIL_TO=
WEBHOOK_URL=

STORAGE_CAPACITY_BYTES=5368709120
